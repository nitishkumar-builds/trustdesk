DATABASE_URL="postgresql://trustdesk:trustdesk@localhost:5432/trustdesk?schema=public"
PORT=4000
NODE_ENV=development
AI_PROVIDER=mock                # mock | openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TIMEOUT_MS=30000
# Optional: override/extend the approximate USD-per-million-token price table in server/src/ai/pricing.ts
# AI_PRICE_TABLE_JSON={"google/gemini-2.5-flash":{"input_per_million":0.3,"output_per_million":2.5}}
DEMO_AGENT_TOKEN=agent-token-123
DEMO_MANAGER_TOKEN=manager-token-123
DEMO_ADMIN_TOKEN=admin-token-123
LOG_LEVEL=info
# Retrieval (Phase 11 item 3): fts is the eval baseline; hybrid fuses FTS with embedding cosine similarity (RRF)
RETRIEVAL_MODE=fts              # fts | hybrid
EMBEDDING_PROVIDER=local        # local (hashing-based, no network) | openrouter (needs OPENROUTER_API_KEY)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Login (Phase 11 item 4): POST /api/auth/login issues a JWT; the three DEMO_*_TOKEN values above keep working as a fallback
JWT_SECRET=trustdesk-dev-jwt-secret-change-me
JWT_TTL_SECONDS=43200
DEMO_USER_PASSWORD=trustdesk-demo   # password of agent@ / manager@ / admin@trustdesk.local (seeded)
